---
import Badge from "@/components/Badge.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import PillLink from "@/components/PillLink.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"

import Layout from "@/layouts/Layout.astro"
---

<Layout
  title="Design System porfolio.dev"
  description="El catálogo de componentes de nuestro porfolio"
>
  <SectionContainer class="py-44 pb-32 flex flex-col gap-y-10">
    <article class="mb-10">
      <h1 class="mb-4 text-xl font-semibold">&lt;Badge /&gt;</h1>

      <Badge>Available for Work</Badge>
    </article>

    <article class="mb-10">
      <h1 class="mb-4 text-xl font-semibold">&lt;PillLink /&gt;</h1>

      <div class="flex">
        <PillLink href="https://linkedin.com/in/gonzalobaldiviezo">
          <LinkedInIcon class="size-4 md:size-6" />
          LinkedIn
        </PillLink>
      </div>
    </article>
  </SectionContainer>
</Layout>
