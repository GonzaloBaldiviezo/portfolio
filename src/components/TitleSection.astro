---
const { className } = Astro.props
---

<div class="mb-8 text-center sm:text-left">
  <h2
    class={`flex items-center justify-center gap-x-3 text-3xl font-bold tracking-tight text-black/80 dark:text-white sm:justify-start ${className ?? ""}`}
  >
    <slot />
  </h2>
  <!-- Gradient accent underline -->
  <div
    class="mt-3 h-px w-20 bg-gradient-to-r from-yellow-400/70 to-transparent"
    aria-hidden="true"
  >
  </div>
</div>
